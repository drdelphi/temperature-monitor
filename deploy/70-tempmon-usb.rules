# Espressif USB Serial/JTAG (ESP32-S3 native USB, GPIO 19/20).
# Number must be < 73 so TAG+=uaccess is applied by 73-seat-late.rules.
# MODE 0666 is required on this host: the graphical session often lacks
# dialout even after usermod, and a 99- rule never receives a logind ACL.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", MODE="0666", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="303a", MODE="0666", GROUP="plugdev", TAG+="uaccess"
ENV{ID_VENDOR_ID}=="303a", ENV{ID_MM_DEVICE_IGNORE}="1"
