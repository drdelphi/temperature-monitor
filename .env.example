# Operator (seeded on API boot)
OWNER_EMAIL=operator@localhost
OWNER_PASSWORD=change-me

# Auth
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_NAME=tm_session
CORS_ORIGINS=http://localhost:3000

# Postgres
POSTGRES_USER=tempmon
POSTGRES_PASSWORD=tempmon_dev_password
POSTGRES_DB=tempmon
DATABASE_URL=postgresql://tempmon:tempmon_dev_password@localhost:5432/tempmon?schema=public

# API
PORT=4000
HOST=0.0.0.0
PUBLIC_API_URL=http://localhost:4000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Twilio SMS (optional until configured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Telegram (optional until configured; can also be set in the dashboard)
TELEGRAM_BOT_TOKEN=
# If set, API registers a webhook at ${PUBLIC_API_URL}/v1/telegram/webhook
# Otherwise it long-polls getUpdates.
TELEGRAM_WEBHOOK_SECRET=
